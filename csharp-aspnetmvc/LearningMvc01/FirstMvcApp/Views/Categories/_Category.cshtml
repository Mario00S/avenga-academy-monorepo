@using FirstMvcApp.Models
@model Category
@{
    string action = ViewBag.Action ?? string.Empty;
}

@section title {
    @if (Model != null)
    {
        <h3>Category: @Model.Name</h3>
    }
}
<form method="post" asp-controller="categories" asp-action="@action">
    @if (action?.ToLower() == "edit")
        {
        <input type="hidden" asp-for="CategoryId" />
        }
    <div class="text-danger" asp-validation-summary="All"></div>
    <div class="row mb-3">
        <div class="col-2">
            <label asp-for="Name" class="col-form-label"></label>
        </div>
        <div class="col-6">
            <input type="text" asp-for="Name" class="form-control" />
        </div>
        <div class="col">
            <span class="text-danger" asp-validation-for="Name"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-2">
            <label asp-for="Description" class="col-form-label"></label>
        </div>
        <div class="col-6">
            <input type="text" asp-for="Description" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-2">
            <input type="submit" asp-for="Description" class="btn btn-primary" value="Save"/>
        </div>
        <div class="col-6">
        </div>
    </div>
</form>
@* <form method="post" action="/categories/edit"></form> *@

    @* <h3>Category: @Model.CategoryId</h3>  must be handled because will throw error:
        @Model.CategoryId throws because Model is null when the requested ID doesn’t exist in your list.
    *@