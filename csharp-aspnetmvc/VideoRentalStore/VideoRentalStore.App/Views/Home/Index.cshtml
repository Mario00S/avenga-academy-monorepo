@{
    ViewBag.Title = "Video Rental Store";
}

<div class="jumbotron text-center">
    <h1>Welcome to Video Rental Store</h1>
    <p>Choose an option below to get started:</p>

    <div class="row mt-4">
        <div class="col-md-6">
            <h3>Browse Movies</h3>
            <p>Preview our movie library before logging in.</p>
            <a asp-controller="Movies" asp-action="Index" class="btn btn-primary btn-lg">Go to Movies</a>
        </div>

        <div class="col-md-6">
            <h3>Login</h3>
            <p>Access your account and manage rentals.</p>
            <a asp-controller="User" asp-action="Login" class="btn btn-success btn-lg">Login</a>
        </div>
    </div>
</div>
