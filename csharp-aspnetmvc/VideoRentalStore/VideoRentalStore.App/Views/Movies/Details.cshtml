@model VideoRentalStore.Models.ViewModels.MovieDetailsViewModel

<h2>@Model.Movie.Title</h2>

<div class="card mb-4">
    @* <img src="@Model.Movie.ImageUrl" class="card-img-top" alt="@Model.Movie.Title poster"> *@
    <div class="card-body">
        <h5 class="card-title">@Model.Movie.Title</h5>
        <p class="card-text"><strong>Genre:</strong> @Model.Movie.Genre</p>
        <p class="card-text"><strong>Language:</strong> @Model.Movie.Language</p>
        <p class="card-text"><strong>Release Date:</strong> @Model.Movie.ReleaseDate.ToShortDateString()</p>
        <p class="card-text"><strong>Length:</strong> @Model.Movie.Length minutes</p>
        <p class="card-text"><strong>Quantity:</strong> @Model.Movie.Quantity</p>
        <p class="card-text"><strong>Available:</strong> @(Model.Movie.IsAvailable ? "Yes" : "No")</p>
    </div>
</div>

<!-- Cast Section -->
<div class="mt-4">
    <h4>Cast</h4>
    @if (Model.CastMembers.Any())
    {
        <ul class="list-group">
            @foreach (var cast in Model.CastMembers)
            {
                <li class="list-group-item">
                    <strong>@cast.Role:</strong> @cast.Name
                </li>
            }
        </ul>
    }
    else
    {
        <p>No cast information available.</p>
    }
</div>

<!-- Rent / Navigation -->
<div class="mt-3">
    @if (Model.Movie.IsAvailable)
    {
        if (Context.Request.Cookies["UserId"] != null)
        {
            <a asp-controller="Movies" asp-action="Rent" asp-route-id="@Model.Movie.Id" class="btn btn-success">Rent</a>
        }
        else
        {
            <p class="text-danger">You must be logged in to rent this movie.</p>
            <a asp-controller="User" asp-action="Login" class="btn btn-primary">Go to Login</a>
        }
    }
    else
    {
        <p class="text-danger">This movie is not available for rent.</p>
    }

    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
