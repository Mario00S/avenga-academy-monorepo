@model Movie

<h2>@Model.Title</h2>

<div class="card mb-4">
    @* <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title poster"> *@
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text"><strong>Genre:</strong> @Model.Genre</p>
        <p class="card-text"><strong>Language:</strong> @Model.Language</p>
        <p class="card-text"><strong>Release Date:</strong> @Model.ReleaseDate.ToShortDateString()</p>
        <p class="card-text"><strong>Length:</strong> @Model.Length minutes</p>
        <p class="card-text"><strong>Quantity:</strong> @Model.Quantity</p>
        <p class="card-text"><strong>Available:</strong> @(Model.IsAvailable ? "Yes" : "No")</p>
    </div>
</div>

<div class="mt-3">
    @if (Model.IsAvailable)
    {
        if (Context.Request.Cookies["UserId"] != null)
        {
            <!-- Link to Rent (GET) confirmation page -->
            <a asp-controller="Movies" asp-action="Rent" asp-route-id="@Model.Id" class="btn btn-success">Rent</a>
        }
        else
        {
            <p class="text-danger">You must be logged in to rent this movie.</p>
            <a asp-controller="User" asp-action="Login" class="btn btn-primary">Go to Login</a>
        }
    }
    else
    {
        <p class="text-danger">This movie is not available for rent.</p>
    }

    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
