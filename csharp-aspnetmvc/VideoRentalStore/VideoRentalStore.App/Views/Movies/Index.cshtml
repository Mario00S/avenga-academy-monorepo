@model IEnumerable<Movie>

<h2>Available Movies</h2>

<div class="row">
    @foreach (var movie in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm">
                <!-- Placeholder image for now -->
                <img src="~/images/placeholder.jpg" class="card-img-top" alt="Movie poster placeholder">

                <div class="card-body">
                    <h5 class="card-title">@movie.Title</h5>
                    <p class="card-text"><strong>Genre:</strong> @movie.Genre</p>
                    <p class="card-text"><strong>Available:</strong> @(movie.IsAvailable ? "Yes" : "No")</p>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id" class="btn btn-info">Details</a>

                    @if (Context.Request.Cookies["UserId"] != null && movie.IsAvailable)
                    {
                        <a asp-controller="Movies" asp-action="Rent" asp-route-id="@movie.Id" class="btn btn-success">Rent</a>
                    }
                    else if (!movie.IsAvailable)
                    {
                        <span class="text-danger">Not available</span>
                    }
                    else
                    {
                        <a asp-controller="User" asp-action="Login" class="btn btn-primary">Login to Rent</a>
                    }
                </div>
            </div>
        </div>
    }
</div>
