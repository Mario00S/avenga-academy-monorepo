@model Movie

<h2>Confirm Rent</h2>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <p class="card-text"><strong>Genre:</strong> @Model.Genre</p>
        <p class="card-text"><strong>Available:</strong> @(Model.IsAvailable ? "Yes" : "No")</p>
    </div>
</div>

@if (Model.IsAvailable)
{
    <form asp-action="RentConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit">Confirm Rent</button>
    </form>
}
else
{
    <p class="text-danger">This movie is not available for rent.</p>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
}
