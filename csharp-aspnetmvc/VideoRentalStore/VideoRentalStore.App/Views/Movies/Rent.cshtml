@model Movie

<h2>Confirm Rent</h2>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <p class="card-text"><strong>Genre:</strong> @Model.Genre</p>
        <p class="card-text"><strong>Available:</strong> @(Model.IsAvailable ? "Yes" : "No")</p>
    </div>
</div>

@if (Model.IsAvailable)
{
    if (Context.Request.Cookies["UserId"] != null){
    <form asp-controller="Movies" asp-action="RentConfirmed" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-success">Confirm Rent</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
    }
    else
    {
        <p class="text-danger">You must be logged in to rent this movie.</p>
        <a asp-controller="User" asp-action="Login" class="btn btn-primary">Go to Login</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    }
}
else
{
    <p class="text-danger">This movie is not available for rent.</p>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
}
