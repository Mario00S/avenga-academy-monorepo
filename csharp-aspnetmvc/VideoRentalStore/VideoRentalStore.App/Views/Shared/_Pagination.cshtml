@{
    int currentPage = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string actionName = ViewBag.ActionName ?? "Index"; // optional flexibility
}

<nav aria-label="Pagination">
    <ul class="pagination justify-content-center">
        @if (currentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="@actionName" asp-route-page="@(currentPage - 1)">Previous</a>
            </li>
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == currentPage ? "active" : "")">
                <a class="page-link" asp-action="@actionName" asp-route-page="@i">@i</a>
            </li>
        }

        @if (currentPage < totalPages)
        {
            <li class="page-item">
                <a class="page-link" asp-action="@actionName" asp-route-page="@(currentPage + 1)">Next</a>
            </li>
        }
    </ul>
</nav>
