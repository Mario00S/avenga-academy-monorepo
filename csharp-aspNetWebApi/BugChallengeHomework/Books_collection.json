{
  "info": {
    "name": "LibraryApi - Books",
    "description": "Postman tests for BooksController.\n\nRun the whole collection from top to bottom. Create Book - Valid stores createdBookId, which Update and Delete then use so seed data (book 1) is not deleted.\n\nbaseUrl default: https://localhost:7205 (http profile: http://localhost:5224).\n\nExpected seed data: 9 books, authors 1-4 (Orwell, Asimov, Le Guin, Harari).\nGenre is serialized as a number: Fiction=1, Fantasy=2, Science=3, History=4, Biography=5.\nminYear filter is exclusive (Year > minYear).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7205" },
    { "key": "createdBookId", "value": "" },
    { "key": "existingBookId", "value": "1" },
    { "key": "existingAuthorId", "value": "1" },
    { "key": "tooLongTitle", "value": "" },
    { "key": "tooLongIsbn", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set(\"tooLongTitle\", \"A\".repeat(201));",
          "pm.collectionVariables.set(\"tooLongIsbn\", \"1\".repeat(21));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "GET Books",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Body is an array of books with the expected shape\", function () {",
                  "    const books = pm.response.json();",
                  "    pm.expect(books).to.be.an(\"array\");",
                  "    pm.expect(books.length).to.be.at.least(9);",
                  "    books.forEach(function (book) {",
                  "        pm.expect(book).to.include.keys(\"id\", \"title\", \"isbn\", \"year\", \"pageCount\", \"genre\", \"authorFullName\");",
                  "        pm.expect(book.id).to.be.a(\"number\");",
                  "        pm.expect(book.title).to.be.a(\"string\").and.to.have.lengthOf.at.least(1);",
                  "        pm.expect(book.authorFullName).to.be.a(\"string\").and.to.not.equal(\"Unknown\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Seeded book 1984 is present\", function () {",
                  "    const books = pm.response.json();",
                  "    const nineteenEightyFour = books.find(book => book.id === 1);",
                  "    pm.expect(nineteenEightyFour).to.not.be.undefined;",
                  "    pm.expect(nineteenEightyFour.title).to.eql(\"1984\");",
                  "    pm.expect(nineteenEightyFour.authorFullName).to.eql(\"George Orwell\");",
                  "    pm.expect(nineteenEightyFour.genre).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Books - Filter by Genre",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books?genre=Fantasy",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                { "key": "genre", "value": "Fantasy" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const FANTASY = 2;",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Every returned book is Fantasy\", function () {",
                  "    const books = pm.response.json();",
                  "    pm.expect(books).to.be.an(\"array\").that.is.not.empty;",
                  "    books.forEach(function (book) {",
                  "        pm.expect(book.genre).to.eql(FANTASY);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Seeded Le Guin fantasy titles are included\", function () {",
                  "    const titles = pm.response.json().map(book => book.title);",
                  "    pm.expect(titles).to.include(\"A Wizard of Earthsea\");",
                  "    pm.expect(titles).to.include(\"The Left Hand of Darkness\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Books - Filter by MinYear (exclusive)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books?minYear=1950",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                { "key": "minYear", "value": "1950" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Filter is exclusive: only books with year > 1950\", function () {",
                  "    const books = pm.response.json();",
                  "    pm.expect(books).to.be.an(\"array\").that.is.not.empty;",
                  "    books.forEach(function (book) {",
                  "        pm.expect(book.year).to.be.above(1950);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"I, Robot (1950) is excluded and Foundation (1951) is included\", function () {",
                  "    const titles = pm.response.json().map(book => book.title);",
                  "    pm.expect(titles).to.not.include(\"I, Robot\");",
                  "    pm.expect(titles).to.include(\"Foundation\");",
                  "});"
                ]
              }
            }
          ]
        },
