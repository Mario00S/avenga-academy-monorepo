    {
      "name": "POST Books",
      "item": [
        {
          "name": "Create Book - Valid",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Hobbit\",\n  \"isbn\": \"978-0547928227\",\n  \"year\": 1937,\n  \"pageCount\": 310,\n  \"genre\": \"Fantasy\",\n  \"authorId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Created book is returned and id is stored\", function () {",
                  "    const book = pm.response.json();",
                  "    pm.expect(book.id).to.be.a(\"number\").and.to.be.above(0);",
                  "    pm.expect(book.title).to.eql(\"The Hobbit\");",
                  "    pm.expect(book.isbn).to.eql(\"978-0547928227\");",
                  "    pm.expect(book.year).to.eql(1937);",
                  "    pm.expect(book.pageCount).to.eql(310);",
                  "    pm.expect(book.genre).to.eql(2);",
                  "    pm.expect(book.authorFullName).to.eql(\"George Orwell\");",
                  "    pm.collectionVariables.set(\"createdBookId\", String(book.id));",
                  "});",
                  "",
                  "pm.test(\"Location header points at the new book\", function () {",
                  "    const location = pm.response.headers.get(\"Location\") || \"\";",
                  "    const id = pm.collectionVariables.get(\"createdBookId\");",
                  "    pm.expect(location.toLowerCase()).to.include(`/api/books/${id}`);",
                  "});"
                ]
              }
            }
          ]
        },
