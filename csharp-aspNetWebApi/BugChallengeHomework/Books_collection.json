        {
          "name": "Get Book By Id - Valid",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books/{{existingBookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{existingBookId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns the seeded 1984 book\", function () {",
                  "    const book = pm.response.json();",
                  "    pm.expect(book.id).to.eql(1);",
                  "    pm.expect(book.title).to.eql(\"1984\");",
                  "    pm.expect(book.isbn).to.eql(\"9780451524935\");",
                  "    pm.expect(book.year).to.eql(1949);",
                  "    pm.expect(book.pageCount).to.eql(328);",
                  "    pm.expect(book.genre).to.eql(1);",
                  "    pm.expect(book.authorFullName).to.eql(\"George Orwell\");",
                  "});"
                ]
              }
            }
          ]
        },
