<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e2b5c6f5-8af7-41aa-91c4-997adeb9e2f8</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
	  <UpToDateCheckBuilt Include="wwwroot/css/site.css" Set="Css" />
  </ItemGroup>
  <Target Name="Tailwind" BeforeTargets="Build;PrepareForPublish">
	  <Exec Command="npm install" />
	  <Exec Command="npx @tailwindcss/cli -i ./wwwroot/css/site.css -o ./wwwroot/css/output.css --minify" />
	  <ItemGroup>
		  <Content Include="wwwroot/css/output.css" CopyToPublishDirectory="Always" />
	  </ItemGroup>
  </Target>
</Project>
